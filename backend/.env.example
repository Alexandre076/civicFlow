# Optional application title shown in the OpenAPI documentation.
CIVICFLOW_APP_NAME=CivicFlow API

# Server-only Google OAuth web client credentials; leave blank to disable login.
CIVICFLOW_GOOGLE_CLIENT_ID=
CIVICFLOW_GOOGLE_CLIENT_SECRET=
CIVICFLOW_DATABASE_URL=postgresql+psycopg://civicflow:civicflow@localhost:5432/civicflow
CIVICFLOW_PUBLIC_ORIGIN=http://localhost:5173
CIVICFLOW_CALLBACK_URL=http://localhost:5173/api/v1/auth/google/callback
CIVICFLOW_ALLOWED_RETURN_PATHS=["/"]
# Explicit loopback HTTP development only. Use true for Codespaces HTTPS.
CIVICFLOW_SECURE_COOKIES=false
CIVICFLOW_LOGIN_TTL=600
CIVICFLOW_SESSION_IDLE_TTL=86400
CIVICFLOW_SESSION_ABSOLUTE_TTL=604800
CIVICFLOW_CLOCK_SKEW=60

# Optional Codespaces only: rewritten Origin still requires matching public Referer.
# CIVICFLOW_TRUSTED_PROXY_ORIGIN=http://localhost:5173
